# Partner-Agent — конфигурация
# Скопируйте в .env и заполните значения.

# --- компания ---------------------------------------------------------
PARTNER_COMPANY=UserGate

# --- провайдер модели: deepseek (API) или ollama (локально) -----------
LLM_PROVIDER=deepseek

# DeepSeek API
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_THINKING=1

# Локальная модель через Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:3b-instruct

# --- лимиты и режимы --------------------------------------------------
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1400
FAST_MAX_TOKENS=350
LOCAL_MAX_TOKENS=300
AGENT_MAX_STEPS=3
AUTO_CONTEXT=1

# --- поиск и индекс ---------------------------------------------------
RAG_TOP_K=6
RAG_USE_DENSE=1
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=120
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- кэш ответов ------------------------------------------------------
ANSWER_CACHE=1
ANSWER_CACHE_THRESHOLD=0.93
ANSWER_CACHE_TTL_DAYS=7
ANSWER_CACHE_MAX_ENTRIES=500

# --- сервер и логи ----------------------------------------------------
APP_HOST=127.0.0.1
APP_PORT=8001
LOG_PROMPTS=1
LOG_TOKENS=1
